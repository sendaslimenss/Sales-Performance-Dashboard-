      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "MoM Growth",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bfx8cj4afgagwe"
                      },
                      "spec": {
                        "dataset": "sales_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH monthly_revenue AS (\r\n    SELECT\r\n        DATE_TRUNC('month', order_date) AS month,\r\n        SUM(revenue) AS revenue\r\n    FROM sales\r\n    WHERE order_date <= $__timeTo()  AND region IN (${region:sqlstring})  AND product_category IN (${product_category:sqlstring})\r\n    GROUP BY DATE_TRUNC('month', order_date)\r\n),\r\ngrowth AS (\r\n    SELECT\r\n        month,\r\n        revenue,\r\n        LAG(revenue) OVER (ORDER BY month) AS previous_revenue\r\n    FROM monthly_revenue\r\n)\r\nSELECT\r\n    ((revenue - previous_revenue) / NULLIF(previous_revenue, 0)) * 100\r\n        AS mom_growth\r\nFROM growth\r\nWHERE month = (\r\n    SELECT MAX(month)\r\n    FROM growth\r\n);",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
